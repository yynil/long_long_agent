{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adr", "seed", "roles", "precision_policy", "strict_lengths", "native_lengths", "native_prefill_chunk", "probe_tokens", "generation_tokens", "generation_max_seconds", "native_thresholds", "failure_policy", "prompts"],
  "properties": {
    "schema_version": {"const": 1}, "adr": {"const": "ADR-019"},
    "seed": {"type": "integer", "minimum": 0},
    "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["smoke", "local_v0"]}},
    "precision_policy": {"const": "original_bf16_native_reduction_on"},
    "strict_lengths": {"$ref": "#/$defs/lengths"},
    "native_lengths": {"type": "object", "additionalProperties": false, "required": ["smoke", "local_v0"], "properties": {"smoke": {"$ref": "#/$defs/lengths"}, "local_v0": {"$ref": "#/$defs/lengths"}}},
    "native_prefill_chunk": {"type": "integer", "minimum": 16, "multipleOf": 16},
    "probe_tokens": {"type": "integer", "minimum": 16, "multipleOf": 16},
    "generation_tokens": {"type": "integer", "minimum": 1},
    "generation_max_seconds": {"type": "number", "exclusiveMinimum": 0},
    "native_thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_rms_max", "mean_kl_max", "p95_kl_max", "top1_agreement_min", "confident_probability_min", "confident_argmax_changes_max"],
      "properties": {
        "relative_rms_max": {"type": "number", "exclusiveMinimum": 0},
        "mean_kl_max": {"type": "number", "exclusiveMinimum": 0},
        "p95_kl_max": {"type": "number", "exclusiveMinimum": 0},
        "top1_agreement_min": {"type": "number", "minimum": 0, "maximum": 1},
        "confident_probability_min": {"type": "number", "exclusiveMinimum": 0.5, "maximum": 1},
        "confident_argmax_changes_max": {"const": 0}
      }
    },
    "failure_policy": {"const": "preserve_all_cases_block_training_and_m0"},
    "prompts": {"type": "array", "minItems": 3, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "task", "continuation"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z_]+$"}, "task": {"type": "string", "minLength": 30}, "continuation": {"type": "string", "minLength": 60}}
    }}
  },
  "$defs": {"lengths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 128, "multipleOf": 16}}}
}
