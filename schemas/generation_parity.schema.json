{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "roles", "seeds", "prefix_lengths", "generation_tokens", "thresholds", "failure_policy"],
  "properties": {
    "schema_version": {"const": 1},
    "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["smoke", "local_v0"]}},
    "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "prefix_lengths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 16, "multipleOf": 16}},
    "generation_tokens": {"type": "integer", "minimum": 1},
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_rms_max", "mean_kl_max", "p95_kl_max", "top1_agreement_min", "k0_identical", "repeated_generation_identical", "finite_logits"],
      "properties": {
        "relative_rms_max": {"type": "number", "exclusiveMinimum": 0},
        "mean_kl_max": {"type": "number", "exclusiveMinimum": 0},
        "p95_kl_max": {"type": "number", "exclusiveMinimum": 0},
        "top1_agreement_min": {"type": "number", "minimum": 0, "maximum": 1},
        "k0_identical": {"const": true}, "repeated_generation_identical": {"const": true}, "finite_logits": {"const": true}
      }
    },
    "failure_policy": {"const": "save_all_results_and_block_long_training_and_m0"}
  }
}
