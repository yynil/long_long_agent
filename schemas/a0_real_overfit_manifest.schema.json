{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://long-long-agent.local/a0_real_overfit_manifest.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "purpose", "phase", "code_commit", "dirty_diff_sha256", "provenance", "runtime", "environment", "input_plan_sha256", "command", "resolved_config", "base_config", "sample_count", "sample_ids_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "purpose": {"const": "real_a0_overfit"},
    "phase": {"enum": ["capacity", "padded", "overfit32", "overfit128"]},
    "code_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "dirty_diff_sha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},
    "provenance": {"$ref": "training_preflight_manifest.schema.json#/properties/provenance"},
    "runtime": {"$ref": "training_preflight_manifest.schema.json#/properties/runtime"},
    "environment": {"$ref": "training_preflight_manifest.schema.json#/properties/environment"},
    "input_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "command": {"type": "array", "items": {"type": "string"}},
    "resolved_config": {"$ref": "a0_real_overfit.schema.json"}, "base_config": {"$ref": "a0_training_preflight.schema.json"},
    "sample_count": {"enum": [1, 32, 128]}, "sample_ids_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
