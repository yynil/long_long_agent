            "p95",
            "max"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "sum": {
              "type": "integer",
              "minimum": 0
            },
            "p50": {
              "type": "number",
              "minimum": 0
            },
            "p95": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
