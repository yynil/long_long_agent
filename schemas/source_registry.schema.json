{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://long-long-agent.local/schemas/source_registry.schema.json",
  "title": "Pinned source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "storage_config", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "storage_config": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "repo_id", "repo_type", "revision", "declared_license",
        "expected_lfs_bytes", "allow_patterns", "adapter", "stage"
      ],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "repo_id": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "repo_type": {"enum": ["dataset", "model"]},
        "revision": {"$ref": "#/$defs/sha40"},
        "declared_license": {"type": "string", "minLength": 1},
        "expected_lfs_bytes": {"type": "integer", "minimum": 1},
        "allow_patterns": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "adapter": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "stage": {"type": "string", "minLength": 1},
        "selection_note": {"type": "string", "minLength": 1}
      }
    }
  }
}
