{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://long-long-agent.local/schemas/heldout_manifest.schema.json",
  "title": "Frozen held-out split policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "created_at",
    "group_identity_version",
    "split_algorithm",
    "salt",
    "bucket_count",
    "ranges",
    "sources",
    "lists",
    "statistics"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "frozen"},
    "created_at": {"type": "string", "format": "date-time"},
    "group_identity_version": {"const": "repo_else_task_v1"},
    "split_algorithm": {"const": "sha256_salted_bucket_v1"},
    "salt": {"type": "string", "minLength": 1},
    "bucket_count": {"const": 10000},
    "ranges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "dev", "test"],
      "properties": {
        "train": {"const": [1000, 9999]},
        "dev": {"const": [500, 999]},
        "test": {"const": [0, 499]}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "revision", "episode_count", "group_count"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "episode_count": {"type": "integer", "minimum": 0},
          "group_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "lists": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dev", "test"],
      "properties": {
        "dev": {"$ref": "#/$defs/hashList"},
        "test": {"$ref": "#/$defs/hashList"}
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_count",
        "global_group_count",
        "cross_source_group_count",
        "invalid_identity_count",
        "episode_split_counts",
        "group_split_counts"
      ],
      "properties": {
        "episode_count": {"type": "integer", "minimum": 0},
        "global_group_count": {"type": "integer", "minimum": 0},
        "cross_source_group_count": {"type": "integer", "minimum": 0},
        "invalid_identity_count": {"const": 0},
        "episode_split_counts": {"$ref": "#/$defs/splitCounts"},
        "group_split_counts": {"$ref": "#/$defs/splitCounts"}
      }
    }
  },
  "$defs": {
    "hashList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "count"],
      "properties": {
        "path": {"type": "string", "pattern": "^[^/]+\\.txt$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "count": {"type": "integer", "minimum": 0}
      }
    },
    "splitCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "dev", "test"],
      "properties": {
        "train": {"type": "integer", "minimum": 0},
        "dev": {"type": "integer", "minimum": 0},
        "test": {"type": "integer", "minimum": 0}
      }
    }
  }
}
