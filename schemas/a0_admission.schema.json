{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A0 admission bound to source, policy, code and content hashes",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "quality_version", "implementation_sha256", "config_sha256", "training_config_sha256", "source_id", "source_revision", "input_files", "task_source", "heldout_sha256", "index_sha256", "source_readme_sha256", "code_commit", "statistics", "accepted"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["passed", "insufficient_eligible_data"]},
    "quality_version": {"const": "agent_quality_v1"},
    "implementation_sha256": {"$ref": "#/$defs/sha256"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "training_config_sha256": {"$ref": "#/$defs/sha256"},
    "source_id": {"const": "open_swe_traces_openhands_pair"},
    "source_revision": {"$ref": "#/$defs/sha40"},
    "input_files": {"$ref": "#/$defs/files"},
    "task_source": {"type": "object", "additionalProperties": false,
      "required": ["source_id", "revision", "files"],
      "properties": {"source_id": {"const": "swe_rebench_v2_tasks"}, "revision": {"$ref": "#/$defs/sha40"}, "files": {"$ref": "#/$defs/files"}}},
    "heldout_sha256": {"$ref": "#/$defs/sha256"},
    "index_sha256": {"$ref": "#/$defs/sha256"},
    "source_readme_sha256": {"$ref": "#/$defs/sha256"},
    "code_commit": {"$ref": "#/$defs/sha40"},
    "statistics": {"type": "object", "additionalProperties": false,
      "required": ["scanned", "accepted", "splits", "teachers", "outcomes", "rejections"],
      "properties": {"scanned": {"type": "integer", "minimum": 0}, "accepted": {"type": "integer", "minimum": 0},
        "splits": {"$ref": "#/$defs/counts"}, "teachers": {"$ref": "#/$defs/counts"},
        "outcomes": {"$ref": "#/$defs/counts"}, "rejections": {"$ref": "#/$defs/counts"}}},
    "accepted": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["source_file", "row_index", "record_sha256", "episode_id", "split", "message_indices", "base_commit", "repo_license", "window_tokens", "dropped_messages"],
      "properties": {
        "source_file": {"type": "string", "pattern": "^data/[^.]+.*\\.parquet$"},
        "row_index": {"type": "integer", "minimum": 0}, "record_sha256": {"$ref": "#/$defs/sha256"},
        "episode_id": {"$ref": "#/$defs/sha256"}, "split": {"enum": ["train", "dev", "test"]},
        "message_indices": {"$ref": "#/$defs/integers"}, "base_commit": {"$ref": "#/$defs/sha40"},
        "repo_license": {"enum": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause"]},
        "window_tokens": {"$ref": "#/$defs/integers"}, "dropped_messages": {"$ref": "#/$defs/integers"}
      }}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sha40": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "integers": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes"], "properties": {
        "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 1}}}}
  }
}
